PORT=3000
HOST=0.0.0.0
# External URL (e.g. https://ppvda.example.com): explicit CORS origin, and
# https:// here forces Secure cookies.
# PUBLIC_URL=
# socks5://, socks4://, http:// or https:// proxy for extraction/download
# egress; DNS is resolved by the proxy.
PROXY_URL=
# Chromium's renderer sandbox. Leave on; in Docker it needs chromium-seccomp.json
# (applied by docker-compose.yml).
CHROMIUM_SANDBOX=true
DOWNLOAD_DIR=./downloads
BROWSER_TIMEOUT_MS=30000
NETWORK_IDLE_MS=2000
DOWNLOAD_TIMEOUT_MS=300000
# Longest HLS/DASH stream accepted, in seconds (live streams are always refused)
MAX_DOWNLOAD_DURATION_SEC=21600
# Per-download size cap in bytes (default 10 GiB)
# MAX_DOWNLOAD_BYTES=10737418240
FFMPEG_PATH=ffmpeg
MAX_CONCURRENT_DOWNLOADS=3
# MAX_CONCURRENT_EXTRACTIONS=3
# ffmpeg processes for /stream-download + /thumbnail (default: MAX_CONCURRENT_DOWNLOADS)
# MAX_CONCURRENT_FFMPEG_ROUTES=3
LOG_LEVEL=info

# Host filtering (comma-separated domains)
PREFERRED_HOSTS=
BLOCKED_HOSTS=
ALLOWED_HOSTS=

# Mullvad VPN (needs NET_ADMIN + /dev/net/tun, as in docker-compose.yml)
MULLVAD_ACCOUNT=
# Required with MULLVAD_ACCOUNT: country (se) or country-city (se-mma)
MULLVAD_LOCATION=
# Comma-separated hostnames that should bypass the VPN (e.g., your Darkreel
# server). Public IPv4 only; fixed at container start.
VPN_BYPASS_HOSTS=

# Admin bootstrap (used on first run only — creates admin user in DB)
PPVDA_ADMIN_USERNAME=admin
PPVDA_ADMIN_PASSWORD=
JWT_SECRET=

# Database
DB_PATH=./data/ppvda.db

# Darkreel uploads (per-user upload-only delegations, refresh token encrypted
# under the user's master key; uploads run in-process, no external binary).
DRK_UPLOAD_TIMEOUT_MS=600000

# Job tracking
MAX_JOB_HISTORY=100

# Features
ENABLE_THUMBNAILS=false
